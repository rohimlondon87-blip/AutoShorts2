name: Robot Upload Shorts (3x Sehari)

on:
  workflow_dispatch:
  schedule:
    # Berjalan 3 kali sehari dalam waktu UTC:
    # 00:00 UTC = 08:00 WITA (Pagi)
    # 08:00 UTC = 16:00 WITA (Sore)
    # 16:00 UTC = 00:00 WITA (Malam)
    - cron: '0 0,8,16 * * *'

jobs:
  upload_shorts:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Pustaka
        run: pip install google-api-python-client google-auth-oauthlib google-auth-httplib2

      - name: Jalankan Upload
        env:
          # Pastikan semua Secret ini sudah ada di GitHub Settings
          TOKEN_DATA: ${{ secrets.TOKEN_DATA }}
          CLIENT_SECRETS_DATA: ${{ secrets.CLIENT_SECRETS_DATA }}
          UPLOTAN_FOLDER_ID: ${{ secrets.UPLOTAN_FOLDER_ID }}
          PROCESSED_FOLDER_ID: ${{ secrets.PROCESSED_FOLDER_ID }}
        run: python auto_shorts.py